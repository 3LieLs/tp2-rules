<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoria</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <form id="formLoja" action="/lojaComprar" method="get">
        <table>
            <tr>
                <th>Produto:</th>
                <th>Preço:</th>
            </tr>
            <tr>
                <td>Arroz</td>
                <td>R$: 19,99</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Arroz')"></td>
            </tr>
            <tr>
                <td>Leite</td>
                <td>R$: 15,99</td>
                <td><input type="submit" name="leite" value="Comprar" onclick="ID('/ID:Leite')"></td>
            </tr>
            <tr>
                <td>Carne</td>
                <td>R$: 21,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Carne')"></td>
            </tr>
            <tr>
                <td>Frango</td>
                <td>R$: 11,99</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Frango')"></td>
            </tr>
            <tr>
                <td>Feijão</td>
                <td>R$: 9,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Feijao')"></td>
            </tr>
            <tr>
                <td>Detergente</td>
                <td>R$: 7,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Detergete')"></td>
            </tr>
            <tr>
                <td>Pão</td>
                <td>R$: 0,50 UND</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Pao')"></td>
            </tr>
            <tr>
                <td>Escova de dente</td>
                <td>R$: 5,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Escova de Dente')"></td>
            </tr>
            <tr>
                <td>Doritos</td>
                <td>R$: 7,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Doritos')"></td>
            </tr>
            <tr>
                <td>Pasta de dente</td>
                <td>R$: 4,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Pasta de Dente')"></td>
            </tr>
            <tr>
                <td>Caldo de cana</td>
                <td>R$: 3,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Caldo de cana')"></td>
            </tr>
            <tr>
                <td>Chave de fenda</td>
                <td>R$: 7,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Chave de fenda')"></td>
            </tr>
            <tr>
                <td>Patê</td>
                <td>R$: 2,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Patê')"></td>
            </tr>
            <tr>
                <td>Bola</td>
                <td>R$: 4,00</td>
                <td><input type="submit" value="Comprar" onclick="ID('/ID:Bola')"></td>
            </tr>
        </table>
        
    </form>

    <script>
        function ID(x) {
            formLoja.action = x
        }
    </script>
</body>

</html>